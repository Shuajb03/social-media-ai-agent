# Mailchimp — powers the newsletter signup form (src/app/api/newsletter/route.ts)
#
# 1. Create a free account at mailchimp.com and an Audience (mailing list).
# 2. API key: Account (bottom left) -> Extras -> API keys -> Create A Key.
#    It looks like: abc123def456...-us21  (the "-us21" suffix is your server prefix)
# 3. Audience ID: Audience -> Settings -> Audience name and defaults -> Audience ID.
#
# Set these as Environment Variables in your Vercel project settings
# (Project -> Settings -> Environment Variables) — do not commit real values here.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=
