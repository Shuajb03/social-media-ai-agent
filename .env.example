# Mailchimp — powers the newsletter signup form (src/app/api/newsletter/route.ts)
#
# 1. Create a free account at mailchimp.com and an Audience (mailing list).
# 2. API key: Account (bottom left) -> Extras -> API keys -> Create A Key.
#    It looks like: abc123def456...-us21  (the "-us21" suffix is your server prefix)
# 3. Audience ID: Audience -> Settings -> Audience name and defaults -> Audience ID.
#
# Set these as Environment Variables in your Vercel project settings
# (Project -> Settings -> Environment Variables) — do not commit real values here.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_SERVER_PREFIX=

# Resend — sends you an email whenever someone places an order or submits
# the contact form (src/app/api/checkout/route.ts, src/app/api/contact/route.ts)
#
# 1. Create a free account at resend.com using the email address you want
#    order/contact notifications sent TO (e.g. skubiofficialbrand@gmail.com).
# 2. API key: Dashboard -> API Keys -> Create API Key.
# 3. Without verifying a custom sending domain, Resend only delivers to the
#    email address you signed up with — which is exactly what we want here.
RESEND_API_KEY=
STORE_NOTIFICATION_EMAIL=

# PayPal — powers the "PayPal" checkout option (src/app/api/paypal/*).
# Stripe doesn't support Kosovo-registered businesses, so PayPal is the
# realistic path to card/online payments here.
#
# 1. Create or log into a PayPal Business account at paypal.com (Kosovo is supported).
# 2. Go to developer.paypal.com -> Apps & Credentials.
# 3. Keep "Sandbox" selected while testing; switch the toggle to "Live" and
#    create a live app when you're ready to accept real payments.
# 4. Create an app, then copy its Client ID and Secret.
#
# NEXT_PUBLIC_PAYPAL_CLIENT_ID is exposed to the browser -- that's expected,
# PayPal Client IDs are meant to be public (like a publishable key).
# PAYPAL_CLIENT_SECRET must stay server-only. The PayPal option only appears
# on the site once NEXT_PUBLIC_PAYPAL_CLIENT_ID is set.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# https://api-m.sandbox.paypal.com while testing, https://api-m.paypal.com when live
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Bank Transfer — shown to the customer on the order confirmation screen
# once they choose Bank Transfer at checkout (src/app/checkout/page.tsx).
# These are exposed to the browser on purpose -- a customer needs to see
# them to actually pay you, so there's nothing to keep secret here. The
# "Bank Transfer" option only appears on the site once all four are set.
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_HOLDER=
NEXT_PUBLIC_BANK_IBAN=
NEXT_PUBLIC_BANK_SWIFT=
